# Firebase browser SDK (safe to expose to the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin — choose ONE configuration method.
# Method A: environment variables (recommended for hosted deployment)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREDACTED\n-----END PRIVATE KEY-----\n"

# Method B: Application Default Credentials (recommended for local/server environments)
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json

# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Admin & staff authentication — server only
# Firebase Authentication stores passwords; do not add administrator passwords here.
ADMIN_EMAIL_FROM=JayLuxe Administration <admin@your-verified-domain.com>

# Resend email — server only
# The sender must use a domain verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=JayLuxe <hello@your-verified-domain.com>
CONTACT_TO_EMAIL=officialjayluxe.ng@gmail.com

# Optional per-message sender overrides (each must use a verified Resend domain)
CONTACT_FROM_EMAIL=JayLuxe Client Care <care@your-verified-domain.com>
ORDER_FROM_EMAIL=JayLuxe Orders <orders@your-verified-domain.com>
BOOKING_TO_EMAIL=officialjayluxe.ng@gmail.com
BOOKING_FROM_EMAIL=JayLuxe Bookings <bookings@your-verified-domain.com>

# Newsletter confirmation and optional owner notification
NEWSLETTER_FROM_EMAIL=The JayLuxe Edit <newsletter@your-verified-domain.com>
NEWSLETTER_REPLY_TO_EMAIL=officialjayluxe.ng@gmail.com
NEWSLETTER_ADMIN_EMAIL=officialjayluxe.ng@gmail.com

# Termii SMS — server only
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=JayLuxe
TERMII_BUSINESS_PHONE=2347072197137
TERMII_OTP_ENABLED=false

# OPay stays disabled until callback, webhook and merchant verification are complete.
NEXT_PUBLIC_OPAY_ENABLED=false
OPAY_ENABLED=false
OPAY_MERCHANT_ID=
OPAY_PRIVATE_KEY=
OPAY_BASE_URL=https://liveapi.opayweb.com

# Analytics
NEXT_PUBLIC_GA_ID=

# Cloudinary upload integration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
