# Copy this file to .env.local and fill in the required values.
# Local development may override NEXT_PUBLIC_APP_URL/NEXT_PUBLIC_SITE_URL with http://localhost:3000.

# JayLuxe production configuration example
# Copy to .env.local for local development or configure these values in your hosting provider.
# Never commit .env.local, service-account JSON files, private keys, or live provider secrets.

# Canonical application URL
NEXT_PUBLIC_APP_URL=https://jayluxestore.com
NEXT_PUBLIC_SITE_URL=https://jayluxestore.com

# Firebase browser SDK (public web-app configuration; safe for the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin — choose ONE server-only configuration method.
# Method A: environment variables
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Method B: Application Default Credentials (Google-managed runtimes only; Vercel should use Method A)
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=secrets/firebase-service-account.json

# Paystack — set the real test/live keys only in the appropriate environment.
# Never commit a live secret key.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Resend — server only. These senders require jayluxestore.com to be verified in Resend.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=JayLuxe <noreply@jayluxestore.com>
ADMIN_EMAIL_FROM=JayLuxe Admin <admin@jayluxestore.com>
ACCOUNT_FROM_EMAIL=JayLuxe <noreply@jayluxestore.com>
CONTACT_FROM_EMAIL=JayLuxe Support <support@jayluxestore.com>
ORDER_FROM_EMAIL=JayLuxe Orders <orders@jayluxestore.com>
BOOKING_FROM_EMAIL=JayLuxe Support <support@jayluxestore.com>
NEWSLETTER_FROM_EMAIL=The JayLuxe Edit <noreply@jayluxestore.com>

# Existing recipient/reply-to addresses — keep these aligned with the business inboxes.
CONTACT_TO_EMAIL=officialjayluxe.ng@gmail.com
BOOKING_TO_EMAIL=officialjayluxe.ng@gmail.com
NEWSLETTER_REPLY_TO_EMAIL=officialjayluxe.ng@gmail.com
NEWSLETTER_ADMIN_EMAIL=officialjayluxe.ng@gmail.com
ADMIN_NOTIFICATION_EMAIL=officialjayluxe.ng@gmail.com
SUPPORT_EMAIL=officialjayluxe.ng@gmail.com


# Email observability
REVIEW_REQUEST_EMAILS_ENABLED=false

# Termii SMS — server only
TERMII_API_KEY=
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_SENDER_ID=JayLuxe
TERMII_BUSINESS_PHONE=2347072197137
TERMII_OTP_ENABLED=false

# OPay remains disabled until its merchant callback/webhook flow is configured and verified.
NEXT_PUBLIC_OPAY_ENABLED=false
OPAY_ENABLED=false
OPAY_MERCHANT_ID=
OPAY_PRIVATE_KEY=
OPAY_BASE_URL=https://liveapi.opayweb.com

# Analytics — do not invent a measurement ID.
NEXT_PUBLIC_GA_ID=

# Cloudinary — API key/secret remain server-side; cloud name may be public.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
